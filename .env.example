# Hostinger MySQL
DATABASE_URL=mysql://user:password@localhost:3306/database

# Public origin and session security
APP_ORIGIN=https://overmountain.xyz
SESSION_TTL_DAYS=30
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Zhihu Open Platform
ZHIHU_APP_ID=
ZHIHU_APP_KEY=
